---
interface Props {
  githubUrl: string;
}
const { githubUrl } = Astro.props;
const profiles = [
  { name: 'GitHub', url: githubUrl },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/casperkorsgaard' },
];
const themes = [
  ['original', 'Original', '#8299b8'],
  ['matrix', 'Terminal matrix', '#63b95c'],
  ['comic', 'Comic brutalistic', '#ecc43b'],
  ['kittens', 'Cute Japanese kittens', '#e69bb4'],
  ['times', 'Times', '#4055ba'],
];
---
<div class="panel-controls">
  <button type="button" popovertarget="site-menu" aria-label="Menu" title="Menu">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" /></svg>
  </button>
  <button type="button" id="open-settings" popovertarget="site-settings" aria-label="Settings" title="Settings" hidden>
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <path d="M3 6h4m4 0h6M3 14h8m4 0h2" /><circle cx="9" cy="6" r="2" /><circle cx="13" cy="14" r="2" />
    </svg>
  </button>
</div>

<aside id="site-menu" class="panel" popover="auto" aria-labelledby="menu-title">
  <div class="panel-heading">
    <h2 id="menu-title">Menu</h2>
    <button type="button" class="close" popovertarget="site-menu" popovertargetaction="hide" aria-label="Close menu">×</button>
  </div>
  <nav aria-label="Pages">
    <a class="option" href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
    <a class="option" href="/links/" aria-current={Astro.url.pathname.replace(/\/$/, '') === '/links' ? 'page' : undefined}>Links</a>
  </nav>
  <nav aria-labelledby="profiles-title">
    <h3 id="profiles-title">Profiles</h3>
    {profiles.map(profile => (
      <a class="option" href={profile.url} target="_blank" rel="noopener noreferrer">{profile.name}<span aria-hidden="true">↗</span></a>
    ))}
  </nav>
</aside>

<aside id="site-settings" class="panel" popover="auto" aria-labelledby="settings-title">
  <div class="panel-heading">
    <h2 id="settings-title">Settings</h2>
    <button type="button" class="close" popovertarget="site-settings" popovertargetaction="hide" aria-label="Close settings">×</button>
  </div>
  <fieldset>
    <legend>Appearance</legend>
    <label class="mode">Color mode
      <select id="color-mode">
        <option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option>
      </select>
    </label>
    <fieldset class="themes">
      <legend>Theme</legend>
      {themes.map(([value, label, color]) => (
        <label class="option">
          <span class="swatch" style={{ '--swatch': color }}></span>{label}
          <input type="radio" name="theme" value={value} checked={value === 'matrix'} />
        </label>
      ))}
    </fieldset>
  </fieldset>
  <fieldset id="scene-options">
    <legend>3D mascot</legend>
    <label class="option">Scene effects <input type="checkbox" id="effects" checked /></label>
    <label class="option">Wireframe <input type="checkbox" id="wireframe" /></label>
  </fieldset>
</aside>

<style>
  button, select { color: inherit; font: inherit; cursor: pointer; }
  button { border: 0; background: transparent; }
  .panel-controls {
    position: fixed; top: max(.5rem, env(safe-area-inset-top)); right: max(.5rem, env(safe-area-inset-right));
    z-index: 3; display: grid; gap: .25rem;
  }
  .panel-controls button, .close {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border-radius: var(--radius);
  }
  .panel-controls button { color: var(--ink); background: var(--card); border: 1px solid var(--rule); }
  .panel-controls button[hidden] { display: none; }
  button:hover, .option:hover { background: var(--shade); border-radius: var(--radius); }
  .panel-controls svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .close { font-size: 1.5rem; }
  .panel {
    position: fixed; top: max(.5rem, env(safe-area-inset-top)); right: calc(max(.5rem, env(safe-area-inset-right)) + 52px);
    bottom: auto; left: auto; margin: 0; width: min(22rem, calc(100% - 68px - env(safe-area-inset-right)));
    max-height: calc(100dvh - 1rem - env(safe-area-inset-top) - env(safe-area-inset-bottom));
    padding: .75rem 1rem 1rem; overflow-y: auto; overscroll-behavior: contain;
    border: 1px solid var(--rule); border-radius: var(--radius); box-shadow: 0 .5rem 1.75rem rgb(0 0 0 / 16%);
    color: var(--ink); background: var(--page);
  }
  .panel-heading, .mode, .option { display: flex; align-items: center; }
  .panel-heading, .mode { justify-content: space-between; gap: 1rem; }
  a[aria-current="page"] { color: var(--accent); font-weight: 700; }
  h2 { margin: 0; font-size: 1.5rem; letter-spacing: -.045em; }
  fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .panel > fieldset, .panel > nav { margin-top: 1.25rem; }
  .panel > fieldset > legend, h3 {
    width: 100%; margin: 0 0 .5rem; padding: 0 0 .4rem; border-bottom: 1px solid var(--rule);
    color: var(--accent); font-size: .95rem; font-weight: 700;
  }
  .mode, .option { min-height: 44px; padding: .3rem .45rem; }
  .mode select { padding: .3rem; border: 1px solid var(--rule); border-radius: .3rem; background: var(--card); }
  .themes { margin-top: .65rem; }
  .themes legend { color: var(--muted); font-size: .875rem; }
  .option { gap: .65rem; cursor: pointer; text-decoration: none; }
  .option input, .option span[aria-hidden] { margin-inline-start: auto; }
  input { accent-color: var(--accent); width: 1rem; height: 1rem; }
  :is(input, select):focus-visible { outline: 3px solid var(--focus); outline-offset: 3px; }
  .swatch { width: .85em; height: .85em; border-radius: 50%; border: 1px solid var(--rule); background: var(--swatch); }
  @media (prefers-reduced-motion: no-preference) {
    .panel:popover-open { animation: slide-in 180ms ease-out; }
    @keyframes slide-in { from { transform: translateX(.375rem); } }
  }
</style>
