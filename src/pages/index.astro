---
import { getPortfolioData } from '../lib/github';

const { profile, projects } = await getPortfolioData();
const intro = profile.bio || 'I build interactive experiments, practical tools, and curious corners of the web.';
const title = profile.name + ' — Projects and experiments';
const description = 'Selected GitHub projects by ' + profile.name + ', with live demos where available.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101521" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://hallojoe.github.io/" />
    <link rel="canonical" href="https://hallojoe.github.io/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="topbar">
        <a class="wordmark" href="/" aria-label="Go to homepage">hallo<span>joe</span><b>.</b></a>
        <a class="profile-link" href={profile.url} target="_blank" rel="noopener noreferrer">GitHub profile ↗</a>
      </header>

      <main>
        <section class="hero" aria-labelledby="headline">
          <div class="hero-copy">
            <p class="eyebrow"><span class="line"></span> Hello, internet</p>
            <h1 id="headline">Hi, I'm <em>{profile.name}.</em><br />I make things <span class="dot">●</span></h1>
            <p class="intro">{intro}</p>
            <div class="hero-links">
              <a class="cta" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
              <a class="secondary" href={profile.url} target="_blank" rel="noopener noreferrer">View on GitHub ↗</a>
            </div>
          </div>
          <aside class="portrait">
            <div class="portrait-frame">
              <img src={profile.avatarUrl} alt={'GitHub profile avatar for ' + profile.name} width="192" height="192" decoding="async" />
            </div>
            <p>{profile.name}<span> / GitHub</span></p>
          </aside>
        </section>

        <section class="work" id="work" aria-labelledby="work-title">
          <div class="section-header">
            <div>
              <p class="eyebrow">Selected work / 01</p>
              <h2 id="work-title">Pinned projects<span class="dot">.</span></h2>
            </div>
            <p class="section-caption">A few things I've chosen to feature on GitHub. Refreshed automatically.</p>
          </div>

          {projects.length > 0 ? (
            <div class="grid">
              {projects.map((project, index) => (
                <article class="project">
                  <div class="card-top">
                    <span class="card-no">{String(index + 1).padStart(2, '0')} / REPO</span>
                    <span class="corner-arrow" aria-hidden="true">↗</span>
                  </div>
                  <div class="card-main">
                    <h3>{project.name}</h3>
                    <p>{project.description || 'A project hosted on GitHub.'}</p>
                  </div>
                  <div class="card-bottom">
                    <div class="meta">
                      {project.language && <span class="language"><i style={project.languageColor ? 'background-color:' + project.languageColor : ''}></i>{project.language}</span>}
                      <span aria-label={project.stars + ' GitHub stars'}>☆ {project.stars}</span>
                    </div>
                    <div class="project-links">
                      <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" aria-label={'Source code for ' + project.name}>Source code ↗</a>
                      {project.pagesUrl && <a class="live" href={project.pagesUrl} target="_blank" rel="noopener noreferrer" aria-label={'Live site for ' + project.name}>Live site ↗</a>}
                    </div>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="empty">There are no pinned repositories to display yet. Pin repositories on GitHub and they will appear after the next build.</p>
          )}
        </section>
      </main>

      <footer>
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <span>Built for the curious. <a href={profile.url} target="_blank" rel="noopener noreferrer">GitHub ↗</a></span>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background: #101521; color: #f2f4f8; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; }
  :global(a:focus-visible) { outline: 3px solid #a8c6ff; outline-offset: 4px; border-radius: 4px; }
  :global(::selection) { background: #b6d5ff; color: #101521; }
  .shell { max-width: 1168px; margin: auto; padding: 0 40px; }
  .topbar { min-height: 104px; display: flex; justify-content: space-between; align-items: center; gap: 16px; border-bottom: 1px solid #2b3546; }
  .wordmark { text-decoration: none; font-size: 25px; font-weight: 760; letter-spacing: -.07em; }
  .wordmark span { color: #a6b6d0; }
  .wordmark b, .dot { color: #a3ddc3; }
  .profile-link { font-size: 13px; color: #c5d0e1; text-decoration: none; border: 1px solid #435067; padding: 11px 15px; border-radius: 100px; transition: border-color .15s; }
  .profile-link:hover { border-color: #a6bddb; color: #fff; }
  .hero { min-height: 580px; display: grid; grid-template-columns: minmax(0, 1fr) 250px; align-items: center; gap: 40px; padding: 100px 0 110px; }
  .eyebrow { text-transform: uppercase; letter-spacing: .17em; font-size: 11px; font-weight: 700; color: #a3ddc3; display: flex; align-items: center; gap: 13px; }
  .line { height: 1px; width: 28px; background: #a3ddc3; display: block; }
  h1 { font-size: clamp(47px, 6vw, 82px); letter-spacing: -.075em; font-weight: 680; line-height: 1.08; margin: 27px 0 24px; }
  h1 em { font-style: normal; color: #a3ddc3; }
  h1 .dot { font-size: .23em; vertical-align: middle; }
  .intro { max-width: 590px; font-size: 19px; line-height: 1.65; color: #aab8cb; }
  .hero-links { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; margin-top: 37px; }
  .cta { background: #a3ddc3; color: #0f2030; font-size: 14px; font-weight: 730; padding: 14px 21px; border-radius: 6px; text-decoration: none; }
  .cta:hover { background: #c0f3db; }
  .cta span { margin-left: 18px; }
  .secondary { color: #d6e0ee; text-decoration: none; border-bottom: 1px solid #66778e; padding-bottom: 5px; font-size: 14px; }
  .secondary:hover { border-color: #a6bddb; color: #fff; }
  .portrait { align-self: center; justify-self: center; text-align: center; }
  .portrait-frame { background: #1c2938; padding: 17px; border: 1px solid #465b70; border-radius: 22px; box-shadow: 20px 20px 0 -4px #1a2733; transform: rotate(4deg); }
  .portrait-frame img { width: 190px; height: 190px; object-fit: cover; border-radius: 12px; display: block; }
  .portrait p { color: #d5dfeb; font-size: 13px; margin-top: 38px; }
  .portrait p span { color: #8294ab; }
  .work { border-top: 1px solid #2b3546; padding: 80px 0 110px; }
  .section-header { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-bottom: 38px; }
  .section-header h2 { font-size: clamp(37px, 4vw, 52px); line-height: 1.1; letter-spacing: -.055em; margin: 14px 0 0; }
  .section-caption { font-size: 14px; line-height: 1.6; color: #8e9db2; max-width: 240px; text-align: right; }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .project { background: #182131; border: 1px solid #303f52; border-radius: 13px; padding: 27px; min-height: 290px; display: flex; flex-direction: column; justify-content: space-between; transition: border-color .2s, transform .2s; }
  .project:hover { border-color: #64836f; transform: translateY(-3px); }
  .card-top, .card-bottom { display: flex; justify-content: space-between; gap: 12px; }
  .card-top { align-items: center; }
  .card-no { font-size: 11px; letter-spacing: .12em; color: #7f97b6; font-weight: 700; }
  .corner-arrow { color: #a3ddc3; font-size: 22px; }
  h3 { font-size: 28px; letter-spacing: -.045em; font-weight: 660; margin: 16px 0 11px; overflow-wrap: anywhere; }
  .card-main p { color: #a6b4c6; font-size: 14px; line-height: 1.6; max-width: 420px; margin: 0; }
  .card-bottom { border-top: 1px solid #344154; padding-top: 19px; margin-top: 29px; flex-wrap: wrap; align-items: center; }
  .meta { display: flex; align-items: center; gap: 15px; color: #8e9cb0; font-size: 12px; }
  .language { display: flex; align-items: center; gap: 6px; }
  .language i { display: inline-block; width: 9px; height: 9px; border-radius: 100%; background: #8da5c6; }
  .project-links { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font-size: 13px; font-weight: 650; }
  .project-links a { text-decoration: none; color: #c7d5e7; }
  .project-links a:hover { text-decoration: underline; }
  .project-links .live { color: #a3ddc3; }
  .empty { background: #182131; border: 1px solid #303f52; border-radius: 13px; padding: 30px; color: #b4c2d4; }
  footer { border-top: 1px solid #2b3546; display: flex; justify-content: space-between; gap: 20px; padding: 28px 0 40px; font-size: 12px; color: #788ba6; }
  footer a { color: #a3ddc3; text-decoration: none; }
  @media (max-width: 780px) {
    .shell { padding: 0 22px; }
    .topbar { min-height: 85px; }
    .hero { grid-template-columns: 1fr; padding: 76px 0 95px; min-height: 0; gap: 60px; }
    .portrait { justify-self: start; margin-left: 16px; }
    .portrait-frame img { height: 140px; width: 140px; }
    .section-header { align-items: start; flex-direction: column; gap: 8px; }
    .section-caption { max-width: 400px; text-align: left; }
    .grid { grid-template-columns: 1fr; }
    .work { padding: 65px 0 80px; }
  }
  @media (max-width: 480px) {
    .project { padding: 22px; }
    h1 { font-size: 49px; }
    footer { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .project { transition: none; }
  }
</style>
