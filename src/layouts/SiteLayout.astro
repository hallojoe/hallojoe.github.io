---
import '../styles/themes.css';
import AnimatedText from '../components/AnimatedText.astro';
import type { AnimatedTextConfig } from '../lib/animated-text';
import type { PortfolioData } from '../lib/github';

interface Props {
  title: string;
  description: string;
  profile: PortfolioData['profile'];
  heading: AnimatedTextConfig;
}
const { title, description, profile, heading } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f4f7fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101521" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <div class="scene-slot" id="page-scene"></div>
    <div class="shell">
      <header class="topbar">
        <a class="wordmark" href="/" aria-label="Go to homepage">hallo<span>joe</span><b>.</b></a>
        <div class="header-actions">
          <div id="appearance" hidden>
            <div class="theme-picker">
              <button type="button" class="theme-toggle" aria-label="Choose theme" title="Choose theme"
                aria-expanded="false" aria-controls="theme-choices"></button>
              <div id="theme-choices" class="swatches" inert role="group" aria-label="Site theme">
                {[
                  ['original', 'Original', '#8299b8'], ['matrix', 'Terminal matrix l', '#63b95c'],
                  ['comic', 'Comic brutalistic', '#ecc43b'], ['kittens', 'Cute japanese kittens', '#e69bb4'],
                  ['times', 'Times', '#4055ba'],
                ].map(([value, name, color]) => (
                  <button type="button" data-theme-choice={value} style={{ '--swatch': color }}
                    title={name} aria-label={name} aria-pressed={value === 'original'}></button>
                ))}
              </div>
            </div>
            <div id="scene-options" role="group" aria-label="3D scene controls">
              <button type="button" id="effects" aria-label="Scene effects" title="Scene effects" aria-pressed="true">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="currentColor" d="m8 2 1.7 5.3L15 9l-5.3 1.7L8 16l-1.7-5.3L1 9l5.3-1.7zm7 9 .9 2.6 2.6.9-2.6.9L15 18l-.9-2.6-2.6-.9 2.6-.9z"/></svg>
              </button>
              <button type="button" id="wireframe" aria-label="Wireframe" title="Wireframe" aria-pressed="false">
                <svg viewBox="0 0 20 20" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" d="m10 2 7 4v8l-7 4-7-4V6zm0 8 7-4M3 6l7 4v8"/></svg>
              </button>
            </div>
            <label class="mode-control">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/><path fill="currentColor" d="M12 4a8 8 0 0 1 0 16z"/></svg>
              <select id="color-mode" aria-label="Color mode" title="Color mode">
                <option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option>
              </select>
            </label>
          </div>
          <a class="profile-link" href={profile.url} target="_blank" rel="noopener noreferrer" title="GitHub profile" aria-label="GitHub profile">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 3.86c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
        </div>
      </header>

      <main>
        <section class="hero" aria-labelledby="headline">
          <h1 id="headline"><AnimatedText config={heading} /></h1>
          <div class="hero-art">
            <div class="scene-slot" id="hero-scene">
              <div id="scene-widget" hidden></div>
            </div>
            <aside class="portrait">
              <div class="portrait-frame">
                <img src={profile.avatarUrl} alt={'GitHub profile avatar for ' + profile.name} width="192" height="192" decoding="async" />
              </div>
            </aside>
          </div>
        </section>

        <slot />
      </main>

      <footer>
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <span>Turtles all the way down <a href={profile.url} target="_blank" rel="noopener noreferrer">GitHub ↗</a></span>
        <div class="scene-slot" id="footer-scene"></div>
      </footer>
    </div>
  <script>
    import '../scripts/appearance.js';
  </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; }
  :global(body) { margin: 0; background-color: var(--page); color: var(--ink); font-family: var(--font); -webkit-font-smoothing: antialiased; }
  :global(a) { color: inherit; }
  :global(:is(a, button):focus-visible) { outline: 3px solid var(--focus); outline-offset: 4px; border-radius: 4px; }
  :global(::selection) { background: var(--focus); color: var(--page); }
  .shell { position: relative; z-index: 1; max-width: 1168px; margin: auto; padding: 0 40px; }
  .topbar { min-height: 64px; display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .wordmark { text-decoration: none; font-size: 25px; font-weight: 760; letter-spacing: -.07em; }
  .wordmark span { color: var(--muted); }
  .wordmark b { color: var(--accent); }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(150px, 34%); align-items: center; gap: 40px; padding: clamp(24px, 3vw, 40px) 0; }
  h1 { font-size: clamp(40px, 5.8vw, 76px); letter-spacing: -.075em; font-weight: 680; line-height: 1.08; margin: 10px 0 8px; }
  .hero-art { min-height: 240px; position: relative; display: grid; place-items: center; align-self: stretch; }
  .portrait { align-self: center; justify-self: center; text-align: center; }
  .portrait-frame { background: var(--card); width: fit-content; margin: auto; padding: 7px; border: 1px solid var(--strong-rule); border-radius: 22px; box-shadow: 8px 8px 0 -4px var(--shade); transform: rotate(4deg); }
  .portrait-frame img { width: 98px; height: 98px; object-fit: cover; border-radius: 12px; display: block; }
  footer { flex-wrap: wrap; align-items: baseline; border-top: 1px solid var(--rule); display: flex; justify-content: space-between; gap: 20px; padding: 28px 0 40px; font-size: 12px; color: var(--muted); }
  footer a { color: var(--accent); text-decoration: none; }
  @media (max-width: 780px) {
    .shell { padding: 0 22px; }
    .topbar { min-height: 56px; }
    .hero { grid-template-columns: minmax(0, 1fr) 26%; gap: 10px; }
    .portrait-frame img { width: 64px; height: 64px; }
  }
  @media (max-width: 380px) {
    .topbar { gap: 4px; }
    .wordmark { font-size: 20px; }
  }
  @media (max-width: 480px) {
    .topbar { flex-wrap: wrap; }
    h1 { font-size: clamp(32px, 8vw, 40px); }
    footer { column-gap: 12px; row-gap: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
  }
</style>
